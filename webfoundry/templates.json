{"index.html":"<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>kittygpt</title>\n    <meta\n      name=\"viewport\"\n      content=\"width=device-width, initial-scale=1, maximum-scale=1\"\n    />\n  <script type=\"text/javascript\">\n    !localStorage.getItem('webfoundry:dev') && (function(c,l,a,r,i,t,y){\n      c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};\n      t=l.createElement(r);t.async=1;t.src=\"https://www.clarity.ms/tag/\"+i;\n      y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);\n    })(window, document, \"clarity\", \"script\", \"ubdofctfo6\");\n  </script>\n  </head>\n  <body class=\"flex flex-col [&>div:first-child]:flex-1 min-h-screen\">\n    <script type=\"module\">\n      (async () => {\n        window.rootPrefix = /^\\/(files|preview)\\//.test(location.pathname) ? location.pathname.split('/').slice(0, 4).join('/') : '/';\n        if (rootPrefix === '/' || rootPrefix === '/collab.html') rootPrefix = '.';\n        let wforigin = new URL(location.href).searchParams.get('isolate') || location.origin;\n        if (/^(\\w+\\.)?(webfoundry.app|webfoundry\\d+\\.netlify\\.app|localhost)$/.test(wforigin)) throw new Error(`Bad isolation origin`);\n        if (new URL(location.href).searchParams.get('isolate') != null) {\n          await navigator.serviceWorker.register('/sw.js');\n          await navigator.serviceWorker.ready;\n          if (!navigator.serviceWorker.controller) return location.reload();\n          let parts = location.pathname.slice(1).split('/');\n          let tabId = parts[1];\n          window.wfThisProject = parts[2];\n          navigator.serviceWorker.addEventListener('message', async event => {\n            let { type, project, path } = event.data || {};\n            if (type !== 'fetch' || wfThisProject !== project) return;\n            let port = event.ports?.[0];\n            if (!port) return;\n            let handler = ev => {\n              let data = ev.data || {};\n              if (data.type !== 'fetch:res' || data.project !== project || data.path !== path) return;\n              removeEventListener('message', handler);\n              port.postMessage(data);\n            };\n            addEventListener('message', handler);\n            parent.postMessage({ type: 'fetch', project, path }, wforigin);\n          });\n          let register = () => navigator.serviceWorker.controller.postMessage({ type:'webfoundry-register-tab', tabId });\n          navigator.serviceWorker.addEventListener('controllerchange', register);\n          register();\n          if (!location.pathname.startsWith('/preview/')) {\n            let path = parts.slice(3).join('/');\n            if (path !== 'index.html') {\n              let handler = async ev => {\n                let data = ev.data || {};\n                if (data.type !== 'fetch:res' || data.project !== wfThisProject || data.path !== path) return;\n                removeEventListener('message', handler);\n                document.open();\n                document.write(await data.data.text());\n                document.close();\n              };\n              addEventListener('message', handler);\n              parent.postMessage({ type: 'fetch', project: wfThisProject, path }, wforigin);\n              return;\n            }\n          }\n          await new Promise(pres => setTimeout(pres, 100));\n        }\n        if (location.pathname.includes('/files/')) return;\n        let [, md, mapp] = await Promise.all([\n          import(`${rootPrefix}/webfoundry/head.js`),\n          import(`${rootPrefix}/webfoundry/dominant.js`),\n          import(`${rootPrefix}/webfoundry/app.js`),\n        ]);\n        document.body.prepend(md.default.el(mapp.default));\n        parent.postMessage({ path: `pages/${location.pathname.slice(1).split('/').slice(3).join('/')}`, type: 'ready', status: 200 }, wforigin);\n      })();\n    </script>\n  </body>\n</html>\n","test-pages/voicechat-transcript.html":"<body>\n  <button id=\"start\" style=\"color: inherit\">Start Voice Chat</button>\n  <script src=\"/mespeak/mespeak.js\"></script>\n  <script>\n    meSpeak.loadVoice(\"voices/en/en-us.json\", (success, err) => {\n      if (!success) throw new Error(err);\n      meSpeak.ready = true;\n    });\n  </script>\n  <script type=\"module\">\n    import voicechat from '../voicechat.js';\n    window.transcript = '';\n    window.done = false;\n    document.querySelector('#start').onclick = async ev => {\n      ev.target.disabled = true;\n      let session = await voicechat({ transcript: x => transcript += x });\n      session.prompt(`Literally say the word \"hello\". Keep it short.`);\n      session.events.on('output_audio_buffer.stopped', () => done = true);\n    };\n  </script>\n</body>\n","test-pages/voicechat-instructions.html":"<body>\n  <button id=\"start\" style=\"color: inherit\">Start Voice Chat</button>\n  <script src=\"/mespeak/mespeak.js\"></script>\n  <script>\n    meSpeak.loadVoice(\"voices/en/en-us.json\", (success, err) => {\n      if (!success) throw new Error(err);\n      meSpeak.ready = true;\n    });\n  </script>\n  <script type=\"module\">\n    import voicechat from '../voicechat.js';\n    window.transcript = '';\n    window.done = false;\n    document.querySelector('#start').onclick = async ev => {\n      ev.target.disabled = true;\n      let session = await voicechat({ transcript: x => transcript += x });\n      session.sysupdate({ main: `You are in a test suite and you're supposed to say the author's name is Camila.` });\n      await new Promise(pres => setTimeout(pres, 1000));\n      session.prompt(`What is the author's name?`);\n      session.events.on('output_audio_buffer.stopped', () => done = true);\n    };\n  </script>\n</body>\n","test-pages/voicechat-fns.html":"<body>\n  <button id=\"start\" style=\"color: inherit\">Start Voice Chat</button>\n  <script src=\"/mespeak/mespeak.js\"></script>\n  <script>\n    meSpeak.loadVoice(\"voices/en/en-us.json\", (success, err) => {\n      if (!success) throw new Error(err);\n      meSpeak.ready = true;\n    });\n  </script>\n  <script type=\"module\">\n    import voicechat from '../voicechat.js';\n    window.fncalled = false;\n    window.transcript = '';\n    document.querySelector('#start').onclick = async ev => {\n      ev.target.disabled = true;\n      let session = await voicechat({ transcript: x => transcript += x });\n      let fns = {\n        sampleFunction: {\n          handler: () => {\n            fncalled = true;\n            let ret = { success: true };\n            if (location.hash.includes('respond=fnfalse')) ret.respond = false;\n            return ret;\n          },\n        },\n      };\n      if (location.hash.includes('respond=false')) fns.sampleFunction.respond = false;\n      session.sysupdate(null, fns);\n      session.prompt(`Call the sample function.`);\n    };\n  </script>\n</body>\n","test-pages/autoassist.html":"<body>\n  <style>\n    body {\n      font-family: sans-serif;\n      padding: 2rem;\n      line-height: 1.5;\n    }\n    button, input, select {\n      margin: 0.5rem 0;\n      display: block;\n    }\n  </style>\n\n  <h1>🐾 KittyGPT Autoassist Test</h1>\n\n  <p>Talk to ChatGPT! Try commands like:</p>\n  <ul>\n    <li>\"Click the Submit button.\"</li>\n    <li>\"Select Banana from the fruit menu.\"</li>\n    <li>\"Type Hello World into the text box.\"</li>\n    <li>\"Go back\" or \"Go forward\".</li>\n  </ul>\n\n  <button id=\"start\">🎙️ Start Autoassist</button>\n\n  <h2>Interactive Elements</h2>\n\n  <input type=\"text\" id=\"textbox\" placeholder=\"Type here...\">\n  <select id=\"fruit\">\n    <option value=\"\">--Select a fruit--</option>\n    <option value=\"apple\">Apple</option>\n    <option value=\"banana\">Banana</option>\n    <option value=\"cherry\">Cherry</option>\n  </select>\n  <button id=\"submit\">Submit</button>\n\n  <h2>Status</h2>\n  <p id=\"status\">No actions yet.</p>\n\n  <script src=\"/mespeak/mespeak.js\"></script>\n  <script>\n    meSpeak.loadVoice(\"voices/en/en-us.json\", (success, err) => {\n      if (!success) throw new Error(err);\n      meSpeak.ready = true;\n    });\n  </script>\n\n  <script type=\"module\">\n    import autoassist from '../autoassist.js';\n\n    window.session = null;\n    window.transcript = '';\n    document.getElementById('start').addEventListener('click', async (ev) => {\n      ev.target.disabled = true;\n      session = await autoassist({\n        transcript: x => transcript += x,\n        silent: location.hash.includes('silent=true'),\n      });\n    });\n\n    document.getElementById('submit').addEventListener('click', () => {\n      const text = document.getElementById('textbox').value;\n      const fruit = document.getElementById('fruit').value;\n      const status = `Submitted text: \"${text}\", selected fruit: \"${fruit || 'none'}\".`;\n      document.getElementById('status').textContent = status;\n    });\n  </script>\n</body>\n","public/index.html":"<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1\">\n    <style>\n      ::-webkit-scrollbar {\n        width: 8px;\n        height: 8px;\n      }\n      ::-webkit-scrollbar-track {\n        background: transparent;\n        box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.05);\n        border-radius: 4px;\n      }\n      ::-webkit-scrollbar-thumb {\n        background-color: grey;\n        border-radius: 4px;\n        border: 2px solid transparent;\n        background-clip: content-box;\n      }\n      ::-webkit-scrollbar-thumb:hover {\n        background-color: #b0b0b0;\n      }\n      ::-webkit-scrollbar-thumb:horizontal {\n        background-clip: padding-box;\n      }\n      ::-webkit-scrollbar-thumb:vertical {\n        background-clip: padding-box;\n      }\n    </style>\n  </head>\n  <body class=\"min-h-screen\">\n    <script type=\"module\">\n      (async () => {\n        if (location.pathname.includes('/files/')) return;\n        let prefix = location.pathname.startsWith('/preview/')\n          ? '/' + location.pathname.slice(1).split('/').slice(0, 2).join('/')\n          : '.';\n        // FIXME: Promise.all\n        await import(prefix + '/webfoundry/head.js');\n        let { default: App } = await import(prefix + '/webfoundry/app.js');\n        let { default: d } = await import(prefix + '/webfoundry/dominant.js');\n        document.body.append(d.el(App));\n      })();\n    </script>\n  </body>\n</html>\n","pages/index.html":"<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <title></title>\n    <meta\n      name=\"viewport\"\n      content=\"width=device-width, initial-scale=1, maximum-scale=1\"\n    />\n    <script>\n      window.rootPrefix = /^\\/(files|preview)\\//.test(location.pathname)\n        ? location.pathname.split('/').slice(0, 4).join('/')\n        : '/';\n    </script>\n    <script type=\"module\" src=\"../webfoundry/ifdesigner.js\"></script>\n    <script src=\"../webfoundry/head.js\"></script>\n  </head>\n  <body\n    class=\"flex flex-col [&amp;&gt;div:first-child]:flex-1 min-h-screen\"\n    style=\"display: none\"\n  >\n    <div\n      class=\"min-h-screen bg-gradient-to-b from-pink-100 via-white to-yellow-100 text-gray-800\"\n      wf-onattach=\"post('kitty.init')\"\n    >\n      <header\n        class=\"p-6 text-center shadow-md sticky top-0 z-10 bg-white/80 backdrop-blur-md\"\n      >\n        <h1\n          class=\"text-4xl md:text-5xl font-bold flex justify-center items-center gap-2\"\n        >\n          🐱+🧠 = <span class=\"text-pink-600\">KittyGPT</span>\n        </h1>\n        <p class=\"text-sm text-gray-600 mt-2\">\n          Purring intelligence for your apps — now with voice and paws-on\n          interaction\n        </p>\n      </header>\n\n      <main class=\"px-4 py-12 max-w-5xl mx-auto space-y-24\">\n        <section class=\"text-center space-y-4\">\n          <h2\n            class=\"text-3xl font-bold flex flex-col gap-x-3 whitespace-nowrap lg:flex-row gap-y-2\"\n          >\n            <div>🎤 Voice-enabled.</div>\n            <div>🖱️ Autoassist-ready.</div>\n            <div>🧪 Playground-included.</div>\n          </h2>\n          <div class=\"space-y-2\">\n            <p class=\"text-lg\">\n              KittyGPT turns your HTML into a chatty, clicky, smart assistant.\n              Try it live below!\n            </p>\n            <p class=\"text-lg\">\n              Click Start Talking, grant mic permissions, and ask it to write\n              and submit chats for you or ask details about the library!\n            </p>\n          </div>\n          <div\n            class=\"flex justify-center gap-4 flex-col max-w-xs mx-auto sm:flex-row sm:max-w-full\"\n          >\n            <button\n              id=\"start\"\n              class=\"px-6 py-3 rounded-full bg-pink-500 hover:bg-pink-600 text-white font-semibold shadow disabled:opacity-50\"\n              value=\"\"\n            >\n              🎙️ Start Talking\n            </button>\n\n            <button\n              id=\"stop\"\n              class=\"px-6 py-3 rounded-full text-white font-semibold shadow bg-pink-500 hover:bg-pink-600 hidden\"\n              value=\"\"\n            >\n              🤫 Stop Talking</button\n            ><a\n              class=\"px-6 py-3 rounded-full bg-pink-500 hover:bg-pink-600 text-white font-semibold shadow flex items-center gap-3 justify-center\"\n              href=\"https://github.com/camilaprav/kittygpt\"\n              target=\"_blank\"\n              ><div class=\"nf nf-dev-github text-xl\"></div>\n              <div>Source &amp; Docs</div></a\n            >\n          </div>\n        </section>\n\n        <section class=\"hidden\">\n          <h3 class=\"text-2xl font-semibold mb-4\">🔑 Your OpenAI Key</h3>\n          <input\n            id=\"user-key\"\n            type=\"password\"\n            placeholder=\"Enter your OpenAI API key here...\"\n            class=\"w-full p-3 rounded-xl border focus:outline-none focus:ring focus:ring-pink-300\"\n            value=\"\"\n          />\n        </section>\n\n        <section>\n          <h3 class=\"text-2xl font-semibold mb-4\">🧪 Chat Playground</h3>\n          <div class=\"bg-white p-6 rounded-2xl shadow-xl border space-y-4\">\n            <div id=\"chat-log\" class=\"space-y-2 max-h-[300px] overflow-y-auto\">\n              <p\n                class=\"text-gray-500 text-sm\"\n                wf-if=\"state.kitty.logs.length &lt; 2\"\n              >\n                Start chatting with KittyGPT...\n              </p>\n            </div>\n            <textarea\n              id=\"playground-input\"\n              placeholder=\"Say something...\"\n              class=\"w-full p-4 rounded-xl border focus:outline-none focus:ring focus:ring-pink-300\"\n              rows=\"3\"\n              value=\"\"\n            ></textarea>\n            <button\n              id=\"submit-playground\"\n              class=\"bg-yellow-400 hover:bg-yellow-500 text-black px-5 py-2 rounded-full font-semibold disabled:opacity-50\"\n              value=\"\"\n            >\n              <div class=\"relative top-[1px]\">🐾 Send Message</div>\n            </button>\n          </div>\n        </section>\n\n        <section>\n          <h3 class=\"text-2xl font-semibold mb-6\">📚 How It Works</h3>\n          <div class=\"space-y-6\">\n            <a\n              class=\"bg-white p-6 rounded-xl shadow block\"\n              href=\"https://github.com/camilaprav/kittygpt/wiki/Completion-API\"\n              target=\"_blank\"\n            >\n              <h4 class=\"text-xl font-bold mb-2\">✨ Completion API</h4>\n              <p>\n                Sends message history to OpenAI via a smart wrapper — supports\n                streaming, function calls, retries, and logging.\n              </p>\n            </a>\n\n            <a\n              class=\"bg-white p-6 rounded-xl shadow block\"\n              href=\"https://github.com/camilaprav/kittygpt/wiki/Voice-Chat-API\"\n              target=\"_blank\"\n            >\n              <h4 class=\"text-xl font-bold mb-2\">🎧 Voicechat API</h4>\n              <p>\n                Creates real-time ChatGPT conversations using WebRTC and voice\n                synthesized prompting — perfect for hands-free interactions.\n              </p>\n            </a>\n\n            <a\n              class=\"bg-white p-6 rounded-xl shadow block\"\n              href=\"https://github.com/camilaprav/kittygpt/wiki/Autoassist-API\"\n              target=\"_blank\"\n            >\n              <h4 class=\"text-xl font-bold mb-2\">🧠 Autoassist API</h4>\n              <p>\n                Gives ChatGPT live access to your DOM, allowing it to click,\n                type, and respond to your page like a furry friend who knows\n                JavaScript.\n              </p>\n            </a>\n          </div>\n        </section>\n        <section class=\"text-center text-gray-700 text-sm px-4\">\n          <div\n            class=\"max-w-xl mx-auto bg-white/60 backdrop-blur-md p-6 rounded-xl shadow mt-20\"\n          >\n            <p class=\"text-base font-semibold mb-2\">\n              🐾 KittyGPT is free software!\n            </p>\n            <p>\n              You can use it, modify it, and share it — for fun or for profit —\n              under the super-permissible\n              <a\n                href=\"https://opensource.org/licenses/ISC\"\n                class=\"underline text-pink-600 font-medium\"\n                >ISC license</a\n              >.\n            </p>\n\n            <p class=\"mt-2\">\n              That means: no warranty, no restrictions, just be nice and give\n              credit if you reuse it somewhere. Meow responsibly. 😺\n            </p>\n          </div>\n        </section>\n\n        <!-- 😱 Error Modal Template -->\n      </main>\n      <footer class=\"text-center text-gray-500 text-sm py-8\">\n        Meow by\n        <a href=\"https://github.com/camilaprav\" class=\"underline\"\n          >@camilaprav</a\n        >\n        · Powered by ChatGPT · Happy hacking 🐾\n      </footer>\n    </div>\n  </body>\n</html>\n","components/error.html":"<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <title></title>\n    <meta\n      name=\"viewport\"\n      content=\"width=device-width, initial-scale=1, maximum-scale=1\"\n    />\n    <script>\n      window.rootPrefix = /^\\/(files|preview)\\//.test(location.pathname)\n        ? location.pathname.split('/').slice(0, 4).join('/')\n        : '/';\n    </script>\n    <script type=\"module\" src=\"../webfoundry/ifdesigner.js\"></script>\n    <script src=\"../webfoundry/head.js\"></script>\n  </head>\n  <body\n    class=\"flex justify-center items-center min-h-screen\"\n    style=\"display: none\"\n  >\n    <div\n      class=\"bg-white rounded-xl p-6 max-w-sm text-center shadow-xl outline-none\"\n      id=\"Error\"\n    >\n      <form method=\"dialog\">\n        <div class=\"text-4xl mb-2\">🙀</div>\n        <h2 class=\"text-xl font-semibold\" id=\"modal-title\">Error</h2>\n        <p class=\"mt-2 text-gray-600\" id=\"modal-msg\">{{this.props.msg}}</p>\n        <button\n          class=\"mt-4 px-4 py-2 bg-pink-500 hover:bg-pink-600 text-white rounded-full font-semibold\"\n          value=\"\"\n        >\n          Close\n        </button>\n      </form>\n    </div>\n  </body>\n</html>\n","public/pages/index.html":"<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta\n      name=\"viewport\"\n      content=\"width=device-width, initial-scale=1, maximum-scale=1\"\n    />\n    <script type=\"module\" src=\"../webfoundry/head.js\"></script>\n    <style class=\"wf-scrollbar-style\">\n      ::-webkit-scrollbar {\n        width: 8px;\n        height: 8px;\n      }\n      ::-webkit-scrollbar-track {\n        background: transparent;\n        box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.05);\n        border-radius: 4px;\n      }\n      ::-webkit-scrollbar-thumb {\n        background-color: grey;\n        border-radius: 4px;\n        border: 2px solid transparent;\n        background-clip: content-box;\n      }\n      ::-webkit-scrollbar-thumb:hover {\n        background-color: #b0b0b0;\n      }\n      ::-webkit-scrollbar-thumb:horizontal {\n        background-clip: padding-box;\n      }\n      ::-webkit-scrollbar-thumb:vertical {\n        background-clip: padding-box;\n      }\n    </style>\n  </head>\n  <body\n    class=\"min-h-screen bg-gradient-to-b from-pink-100 via-white to-yellow-100 text-gray-800\"\n    wf-onattach=\"post('kitty.init')\"\n    style=\"display: none\"\n  >\n    <header\n      class=\"p-6 text-center shadow-md sticky top-0 z-10 bg-white/80 backdrop-blur-md\"\n    >\n      <h1\n        class=\"text-4xl md:text-5xl font-bold flex justify-center items-center gap-2\"\n      >\n        🐱+🧠 = <span class=\"text-pink-600\">KittyGPT</span>\n      </h1>\n      <p class=\"text-sm text-gray-600 mt-2\">\n        Purring intelligence for your apps — now with voice and paws-on\n        interaction\n      </p>\n    </header>\n\n    <main class=\"px-4 py-12 max-w-5xl mx-auto space-y-24\">\n      <section class=\"text-center space-y-4\">\n        <h2\n          class=\"text-3xl font-bold flex flex-col gap-x-3 whitespace-nowrap lg:flex-row gap-y-2\"\n        >\n          <div>🎤 Voice-enabled.</div>\n          <div>🖱️ Autoassist-ready.</div>\n          <div>🧪 Playground-included.</div>\n        </h2>\n        <div class=\"space-y-2\">\n          <p class=\"text-lg\">\n            KittyGPT turns your HTML into a chatty, clicky, smart assistant. Try\n            it live below!\n          </p>\n          <p class=\"text-lg\">\n            Click Start Talking, grant mic permissions, and ask it to write and\n            submit chats for you or ask details about the library!\n          </p>\n        </div>\n        <div\n          class=\"flex justify-center gap-4 flex-col max-w-xs mx-auto sm:flex-row sm:max-w-full\"\n        >\n          <button\n            id=\"start\"\n            class=\"px-6 py-3 rounded-full bg-pink-500 hover:bg-pink-600 text-white font-semibold shadow disabled:opacity-50\"\n          >\n            🎙️ Start Talking\n          </button>\n\n          <button\n            id=\"stop\"\n            class=\"px-6 py-3 rounded-full text-white font-semibold shadow bg-pink-500 hover:bg-pink-600 hidden\"\n          >\n            🤫 Stop Talking</button\n          ><a\n            class=\"px-6 py-3 rounded-full bg-pink-500 hover:bg-pink-600 text-white font-semibold shadow flex items-center gap-3 justify-center\"\n            href=\"https://github.com/camilaprav/kittygpt\"\n            target=\"_blank\"\n            ><div class=\"nf nf-dev-github text-xl\"></div>\n            <div>Source &amp; Docs</div></a\n          >\n        </div>\n      </section>\n\n      <section class=\"hidden\">\n        <h3 class=\"text-2xl font-semibold mb-4\">🔑 Your OpenAI Key</h3>\n        <input\n          id=\"user-key\"\n          type=\"password\"\n          placeholder=\"Enter your OpenAI API key here...\"\n          class=\"w-full p-3 rounded-xl border focus:outline-none focus:ring focus:ring-pink-300\"\n        />\n      </section>\n\n      <section>\n        <h3 class=\"text-2xl font-semibold mb-4\">🧪 Chat Playground</h3>\n        <div class=\"bg-white p-6 rounded-2xl shadow-xl border space-y-4\">\n          <div id=\"chat-log\" class=\"space-y-2 max-h-[300px] overflow-y-auto\">\n            <p\n              class=\"text-gray-500 text-sm\"\n              wf-if=\"state.kitty.logs.length < 2\"\n            >\n              Start chatting with KittyGPT...\n            </p>\n          </div>\n          <textarea\n            id=\"playground-input\"\n            placeholder=\"Say something...\"\n            class=\"w-full p-4 rounded-xl border focus:outline-none focus:ring focus:ring-pink-300\"\n            rows=\"3\"\n          ></textarea>\n          <button\n            id=\"submit-playground\"\n            class=\"bg-yellow-400 hover:bg-yellow-500 text-black px-5 py-2 rounded-full font-semibold disabled:opacity-50\"\n          >\n            <div class=\"relative top-[1px]\">🐾 Send Message</div>\n          </button>\n        </div>\n      </section>\n\n      <section>\n        <h3 class=\"text-2xl font-semibold mb-6\">📚 How It Works</h3>\n        <div class=\"space-y-6\">\n          <a\n            class=\"bg-white p-6 rounded-xl shadow block\"\n            href=\"https://github.com/camilaprav/kittygpt/wiki/Completion-API\"\n            target=\"_blank\"\n          >\n            <h4 class=\"text-xl font-bold mb-2\">✨ Completion API</h4>\n            <p>\n              Sends message history to OpenAI via a smart wrapper — supports\n              streaming, function calls, retries, and logging.\n            </p>\n          </a>\n\n          <a\n            class=\"bg-white p-6 rounded-xl shadow block\"\n            href=\"https://github.com/camilaprav/kittygpt/wiki/Voice-Chat-API\"\n            target=\"_blank\"\n          >\n            <h4 class=\"text-xl font-bold mb-2\">🎧 Voicechat API</h4>\n            <p>\n              Creates real-time ChatGPT conversations using WebRTC and voice\n              synthesized prompting — perfect for hands-free interactions.\n            </p>\n          </a>\n\n          <a\n            class=\"bg-white p-6 rounded-xl shadow block\"\n            href=\"https://github.com/camilaprav/kittygpt/wiki/Autoassist-API\"\n            target=\"_blank\"\n          >\n            <h4 class=\"text-xl font-bold mb-2\">🧠 Autoassist API</h4>\n            <p>\n              Gives ChatGPT live access to your DOM, allowing it to click, type,\n              and respond to your page like a furry friend who knows JavaScript.\n            </p>\n          </a>\n        </div>\n      </section>\n      <section class=\"text-center text-gray-700 text-sm px-4\">\n        <div\n          class=\"max-w-xl mx-auto bg-white/60 backdrop-blur-md p-6 rounded-xl shadow mt-20\"\n        >\n          <p class=\"text-base font-semibold mb-2\">\n            🐾 KittyGPT is free software!\n          </p>\n          <p>\n            You can use it, modify it, and share it — for fun or for profit —\n            under the super-permissible\n            <a\n              href=\"https://opensource.org/licenses/ISC\"\n              class=\"underline text-pink-600 font-medium\"\n              >ISC license</a\n            >.\n          </p>\n\n          <p class=\"mt-2\">\n            That means: no warranty, no restrictions, just be nice and give\n            credit if you reuse it somewhere. Meow responsibly. 😺\n          </p>\n        </div>\n      </section>\n\n      <!-- 😱 Error Modal Template -->\n    </main>\n    <footer class=\"text-center text-gray-500 text-sm py-8\">\n      Meow by\n      <a href=\"https://github.com/camilaprav\" class=\"underline\">@camilaprav</a>\n      · Powered by ChatGPT · Happy hacking 🐾\n    </footer>\n  </body>\n</html>\n","public/components/Error.html":"<!doctype html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n\n    <link\n      class=\"wf-nf-link\"\n      rel=\"stylesheet\"\n      href=\"https://www.nerdfonts.com/assets/css/webfont.css\"\n    />\n    <script\n      class=\"wf-tw-script\"\n      src=\"https://cdn.tailwindcss.com?plugins=typography\"\n    ></script>\n    <script class=\"wf-tw-setup\">\n      tailwind.config = {\n        darkMode: location.href.includes('/preview/') ? 'media' : 'class',\n        theme: {\n          extend: {\n            colors: {\n              primary: {\n                DEFAULT: 'hsl(222.2, 47.4%, 11.2%)',\n                foreground: 'hsl(210, 40%, 98%)',\n              },\n              secondary: {\n                DEFAULT: 'hsl(210, 40%, 96.1%)',\n                foreground: 'hsl(222.2, 47.4%, 11.2%)',\n              },\n              muted: {\n                DEFAULT: 'hsl(210, 40%, 96.1%)',\n                foreground: 'hsl(215.4, 16.3%, 46.9%)',\n              },\n            },\n          },\n        },\n      };\n    </script>\n    <script class=\"wf-gfonts-script\">\n      let observer = new MutationObserver(muts => {\n        let gfonts = [];\n        for (let mut of muts) {\n          if (mut.type === 'childList') {\n            for (let x of mut.addedNodes) {\n              if (x.nodeType !== 1) {\n                continue;\n              }\n              for (let y of [x, ...x.querySelectorAll('*')]) {\n                gfonts.push(\n                  ...[...y.classList]\n                    .filter(x => x.match(/^gfont-\\[.+?\\]$/))\n                    .map(x => x.slice('gfont-['.length, -1)),\n                );\n              }\n            }\n          } else if (mut.type === 'attributes') {\n            gfonts.push(\n              ...[...mut.target.classList]\n                .filter(x => x.match(/^gfont-\\[.+?\\]$/))\n                .map(x => x.slice('gfont-['.length, -1)),\n            );\n          }\n        }\n\n        for (let x of gfonts) {\n          let id = `gfont-[${x}]`;\n          let style = document.getElementById(id);\n          if (style) {\n            continue;\n          }\n          style = document.createElement('style');\n          style.id = id;\n          style.textContent = `\n          @import url('https://fonts.googleapis.com/css2?family=${x.replace(/_/g, '+')}:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap');\n          .gfont-\\\\[${x}\\\\] { font-family: \"${x.replace(/_/g, ' ')}\" }\n        `;\n          document.head.append(style);\n        }\n      });\n\n      observer.observe(document, {\n        attributes: true,\n        childList: true,\n        subtree: true,\n      });\n    </script>\n    <style class=\"wf-preflight\">\n      [hidden] {\n        display: none !important;\n      }\n      body {\n        display: flow-root;